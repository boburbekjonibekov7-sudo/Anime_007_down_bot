# Telegram bot token (BotFather'dan olingan)
BOT_TOKEN=your_bot_token_from_botfather

# Adminlar (vergul bilan ajratiladi)
ADMIN_IDS=7538793043

# Webhook: serveringizning HTTPS manzili (domen + Caddy/Nginx kerak)
# Masalan: WEBHOOK_URL=https://anime-bot.example.com
# Bo'sh qoldirilsa, bot polling rejimida ishlaydi
WEBHOOK_URL=https://bot.example.com
WEBHOOK_PATH=/webhook
# Xavfsizlik uchun ixtiyoriy secret (Telegram har so'rovda shu header'ni yuboradi)
WEBHOOK_SECRET=

# Server port
PORT=10000

# Ma'lumotlar bazasi joyi (Docker ichida)
DB_PATH=/app/data/anime_bot.db

# Python versiyasi (Render uchun ham ishlatiladi)
PYTHON_VERSION=3.11.9
